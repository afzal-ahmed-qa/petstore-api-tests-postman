{
	"info": {
		"name": "Swagger Petstore API tests",
		"description": "End-to-end API tests for https://petstore.swagger.io/v2. Each run creates its own data and removes it again. Findings are in docs/findings.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Checks that apply to every request",
					"const budget = Number(pm.collectionVariables.get('maxResponseTimeMs'));",
					"",
					"if (pm.info.requestName !== 'Check the API is up') {",
					"    pm.test(`Response time is under ${budget} ms`, () => {",
					"        pm.expect(pm.response.responseTime).to.be.below(budget);",
					"    });",
					"}",
					"",
					"if (pm.response.text().length > 0) {",
					"    pm.test('Response is JSON', () => {",
					"        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"    });",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "00 Warm-up",
			"description": "The public Petstore can take several seconds to answer the first call after a quiet period. This request wakes it up and is left out of the response-time check.",
			"item": [
				{
					"name": "Check the API is up",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('API is reachable', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/store/inventory",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"store",
								"inventory"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 Pet lifecycle",
			"description": "Creates a pet, changes it in every way the API allows, finds it again, then deletes it.",
			"item": [
				{
					"name": "Add a new pet",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Unique data for this run so we never clash with other people using the public Petstore",
									"const suffix = Date.now().toString(36);",
									"pm.collectionVariables.set('petId', 9000000000 + Math.floor(Math.random() * 99999999));",
									"pm.collectionVariables.set('petName', `qa-dog-${suffix}`);",
									"pm.collectionVariables.set('tagName', `qa-tag-${suffix}`);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const pet = pm.response.json();",
									"",
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"",
									"pm.test('Pet is returned with the data we sent', () => {",
									"    pm.expect(pet.id).to.eql(Number(pm.collectionVariables.get('petId')));",
									"    pm.expect(pet.name).to.eql(pm.collectionVariables.get('petName'));",
									"    pm.expect(pet.status).to.eql('available');",
									"    pm.expect(pet.category).to.eql({ id: 1, name: 'Dogs' });",
									"    pm.expect(pet.tags.map(t => t.name)).to.include(pm.collectionVariables.get('tagName'));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": {{petId}},\n  \"category\": {\n    \"id\": 1,\n    \"name\": \"Dogs\"\n  },\n  \"name\": \"{{petName}}\",\n  \"photoUrls\": [\n    \"https://example.com/photos/{{petName}}.jpg\"\n  ],\n  \"tags\": [\n    {\n      \"id\": 1,\n      \"name\": \"{{tagName}}\"\n    }\n  ],\n  \"status\": \"available\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "Get the pet by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const petSchema = {",
									"    type: 'object',",
									"    required: ['id', 'name', 'photoUrls', 'status'],",
									"    properties: {",
									"        id: { type: 'integer' },",
									"        name: { type: 'string' },",
									"        category: { type: 'object', properties: { id: { type: 'integer' }, name: { type: 'string' } } },",
									"        photoUrls: { type: 'array', items: { type: 'string' } },",
									"        tags: { type: 'array', items: { type: 'object', properties: { id: { type: 'integer' }, name: { type: 'string' } } } },",
									"        status: { enum: ['available', 'pending', 'sold'] }",
									"    }",
									"};",
									"",
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('Response matches the Pet schema', () => pm.response.to.have.jsonSchema(petSchema));",
									"pm.test('It is the pet we just created', () => {",
									"    pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('petName'));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet/{{petId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet",
								"{{petId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Rename the pet and mark it pending (PUT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('Name and status are updated', () => {",
									"    const pet = pm.response.json();",
									"    pm.expect(pet.name).to.eql(pm.collectionVariables.get('petName') + '-renamed');",
									"    pm.expect(pet.status).to.eql('pending');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": {{petId}},\n  \"category\": {\n    \"id\": 1,\n    \"name\": \"Dogs\"\n  },\n  \"name\": \"{{petName}}-renamed\",\n  \"photoUrls\": [\n    \"https://example.com/photos/{{petName}}.jpg\"\n  ],\n  \"tags\": [\n    {\n      \"id\": 1,\n      \"name\": \"{{tagName}}\"\n    }\n  ],\n  \"status\": \"pending\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "Update name and status with form data",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('API confirms the pet ID it updated', () => {",
									"    pm.expect(pm.response.json().message).to.eql(String(pm.collectionVariables.get('petId')));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet/{{petId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet",
								"{{petId}}"
							]
						},
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "name",
									"value": "{{petName}}-sold",
									"type": "text"
								},
								{
									"key": "status",
									"value": "sold",
									"type": "text"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Upload a photo",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('File and metadata are acknowledged', () => {",
									"    const { message } = pm.response.json();",
									"    pm.expect(message).to.include('additionalMetadata: front view');",
									"    pm.expect(message).to.include('File uploaded to ./pet-photo.png');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet/{{petId}}/uploadImage",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet",
								"{{petId}}",
								"uploadImage"
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "additionalMetadata",
									"value": "front view",
									"type": "text"
								},
								{
									"key": "file",
									"type": "file",
									"src": "data/pet-photo.png"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Our pet shows up in the \"sold\" list",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const pets = pm.response.json();",
									"const petId = Number(pm.collectionVariables.get('petId'));",
									"",
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('Every pet in the list is sold', () => {",
									"    pm.expect(pets).to.be.an('array').that.is.not.empty;",
									"    pets.forEach(p => pm.expect(p.status, `pet ${p.id}`).to.eql('sold'));",
									"});",
									"pm.test('Our pet is in the list', () => {",
									"    pm.expect(pets.map(p => p.id)).to.include(petId);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet/findByStatus?status=sold",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet",
								"findByStatus"
							],
							"query": [
								{
									"key": "status",
									"value": "sold"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Find the pet by its tag",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const match = pm.response.json().find(p => p.id === Number(pm.collectionVariables.get('petId')));",
									"",
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('Pet is found and has the name set by the form update', () => {",
									"    pm.expect(match, 'pet with our tag').to.exist;",
									"    pm.expect(match.name).to.eql(pm.collectionVariables.get('petName') + '-sold');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet/findByTags?tags={{tagName}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet",
								"findByTags"
							],
							"query": [
								{
									"key": "tags",
									"value": "{{tagName}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete the pet",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('API confirms the deleted ID', () => {",
									"    pm.expect(pm.response.json().message).to.eql(String(pm.collectionVariables.get('petId')));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "api_key",
								"value": "{{apiKey}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet/{{petId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet",
								"{{petId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Deleted pet can no longer be found",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 404', () => pm.response.to.have.status(404));",
									"pm.test('Error message is \"Pet not found\"', () => {",
									"    pm.expect(pm.response.json().message).to.eql('Pet not found');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/pet/{{petId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"pet",
								"{{petId}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02 Store orders",
			"description": "Inventory, then the full life of one order.",
			"item": [
				{
					"name": "Inventory counts are numbers",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const inventory = pm.response.json();",
									"",
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('Each status maps to a non-negative whole number', () => {",
									"    pm.expect(inventory).to.be.an('object').that.is.not.empty;",
									"    Object.entries(inventory).forEach(([status, count]) => {",
									"        pm.expect(Number.isInteger(count) && count >= 0, `${status}: ${count}`).to.be.true;",
									"    });",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/store/inventory",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"store",
								"inventory"
							]
						}
					},
					"response": []
				},
				{
					"name": "Place an order",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set('orderId', 9000000000 + Math.floor(Math.random() * 99999999));",
									"pm.collectionVariables.set('orderPetId', 9000000000 + Math.floor(Math.random() * 99999999));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const order = pm.response.json();",
									"",
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('Order is stored as sent', () => {",
									"    pm.expect(order.id).to.eql(Number(pm.collectionVariables.get('orderId')));",
									"    pm.expect(order.petId).to.eql(Number(pm.collectionVariables.get('orderPetId')));",
									"    pm.expect(order.quantity).to.eql(2);",
									"    pm.expect(order.status).to.eql('placed');",
									"    pm.expect(order.complete).to.be.false;",
									"});",
									"pm.test('Ship date keeps the same moment in time', () => {",
									"    pm.expect(new Date(order.shipDate).toISOString()).to.eql('2026-12-01T10:00:00.000Z');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/store/order",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"store",
								"order"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": {{orderId}},\n  \"petId\": {{orderPetId}},\n  \"quantity\": 2,\n  \"shipDate\": \"2026-12-01T10:00:00.000Z\",\n  \"status\": \"placed\",\n  \"complete\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "Get the order",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('Same order comes back', () => {",
									"    const order = pm.response.json();",
									"    pm.expect(order.id).to.eql(Number(pm.collectionVariables.get('orderId')));",
									"    pm.expect(order.status).to.eql('placed');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/store/order/{{orderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"store",
								"order",
								"{{orderId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Cancel the order",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.response.to.have.status(200));",
									"pm.test('API confirms the cancelled order ID', () => {",
									"    pm.expect(pm.response.json().message).to.eql(String(pm.collectionVariables.get('orderId')));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/store/order/{{orderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"store",
								"order",
								"{{orderId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Cancelled order is gone",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 404', () => pm.response.to.have.status(404));",
									"pm.test('Error message is \"Order not found\"', () => pm.expect(pm.response.json().message).to.eql('Order not found'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/store/order/{{orderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"store",
								"order",
								"{{orderId}}"
							]
						}
					},
					"response": []
