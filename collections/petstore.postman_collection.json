								"type": "text/javascript",
								"exec": [
									"const status = pm.iterationData.get('status') || pm.collectionVariables.get('status');",
									"const pets = pm.response.json();",
									"",
									"pm.test(`[${status}] Status code is 200`, () => pm.response.to.have.status(200));",
									"pm.test(`[${status}] All pets have status \"${status}\"`, () => {",
									"    pm.expect(pets).to.be.an('array');",
									"    const wrong = pets.filter(p => p.status !== status).map(p => p.id);",
